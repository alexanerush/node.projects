{
  "name": "log-assignment",
  "version": "1.0.0",
  "description": "Two Node.js apps: Log Generator and Log Analyzer with a shared Logger module.",
  "main": "src/generator/index.js",
  "type": "module",
  "scripts": {
    "start:generator": "node src/generator/index.js",
    "analyze": "node src/analyzer/index.js",
    "analyze:error": "node src/analyzer/index.js --type error",
    "analyze:success": "node src/analyzer/index.js --type success",
    "analyze:warn": "node src/analyzer/index.js --type warn",
    "dev": "node server.js",
    "migrate": "node db/migrate.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nanoid": "^5.1.6",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "ws": "^8.19.0",
    "zod": "^4.1.12"
  }
}
